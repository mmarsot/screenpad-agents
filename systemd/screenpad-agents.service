[Unit]
Description=ScreenPad agent app (Herdr's agents and firstmate's Captain's Calls on the touch bar)
Documentation=https://github.com/mmarsot/screenpad-agents/blob/main/docs/agents.md
# A client of the touch bar's socket, in the graphical session. Installed but
# never enabled by install.sh: it does nothing until you write its config and
# enable it ('systemctl --user enable --now screenpad-agents').
PartOf=graphical-session.target
After=graphical-session.target screenpad-touchbar.service
ConditionPathExists=%E/screenpad/agents.toml

[Service]
ExecStart=%h/.local/bin/screenpad-agents run
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=2
# The app's own limit: the browser it opens the decisions board with runs in a
# scope of its own (systemd-run --user --scope), outside this unit.
MemoryMax=64M

[Install]
WantedBy=graphical-session.target
